# Copy this file to .env and fill in your values
# cp .env.example .env

# ── Groq (Cloud LLM - Free) ───────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=katnoria_RAG
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_SSLMODE=prefer  # Use 'require' for Neon / cloud Postgres, 'prefer' or 'disable' for local

# ── API Security ──────────────────────────────────────────────
# Set a secret key to protect all endpoints (leave empty to disable)
API_KEY=
# Comma-separated allowed origins (use * for dev, restrict in production)
CORS_ORIGINS=*
